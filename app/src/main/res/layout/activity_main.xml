<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="16dp">

    <!-- HEADER WITH CODED LOGO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/oiltimanto_logo"
            android:contentDescription="Logo"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OILTIMANTO"
            android:textColor="#FACC15"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp"/>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="USOIL SWING - MTF ENGINE"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"/>

    <!-- MTF LIGHTS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4"
        android:layout_marginBottom="16dp">

        <TextView android:id="@+id/h1Light"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="H1 ● WAIT"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:background="#64748B"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView android:id="@+id/h4Light"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="H4 ● WAIT"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:background="#64748B"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView android:id="@+id/d1Light"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="D1 ● WAIT"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:background="#64748B"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView android:id="@+id/w1Light"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="W1 ● WAIT"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:background="#64748B"
            android:textSize="12sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <Button
        android:id="@+id/checkMTFBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CHECK MTF CONFLUENCE"
        android:backgroundTint="#FACC15"
        android:textColor="#0F172A"
        android:layout_marginBottom="16dp"/>

    <!-- LOT CALCULATOR -->
    <EditText android:id="@+id/equityInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Equity $ e.g. 1000"
        android:textColorHint="#94A3B8"
        android:textColor="#FFFFFF"
        android:inputType="numberDecimal"
        android:backgroundTint="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <EditText android:id="@+id/riskInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Risk % e.g. 2"
        android:textColorHint="#94A3B8"
        android:textColor="#FFFFFF"
        android:inputType="numberDecimal"
        android:backgroundTint="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <EditText android:id="@+id/entryInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Entry Price e.g. 78.50"
        android:textColorHint="#94A3B8"
        android:textColor="#FFFFFF"
        android:inputType="numberDecimal"
        android:backgroundTint="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <EditText android:id="@+id/slInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="SL Price e.g. 77.50"
        android:textColorHint="#94A3B8"
        android:textColor="#FFFFFF"
        android:inputType="numberDecimal"
        android:backgroundTint="#FFFFFF"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/calculateBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CALCULATE LOT SIZE"
        android:backgroundTint="#22C55E"
        android:textColor="#FFFFFF"/>

    <TextView android:id="@+id/resultText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Result will show here"
        android:textColor="#FACC15"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:background="#1E293B"/>

</LinearLayout>